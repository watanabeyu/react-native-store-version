// ビルド用（`pnpm build`）。tsc だけで dist/ に ESM と .d.ts を出す（D27）
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // removeComments は付けない（JSDoc を .d.ts に残すため）。src を同梱するので source map も出さない
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmitOnError": true
  },
  "include": ["src"]
}
