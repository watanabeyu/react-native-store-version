{
  "name": "react-native-store-version",
  "version": "1.4.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watanabeyu/react-native-store-version.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "appstore",
    "playstore",
    "version"
  ],
  "author": "Yu Watanabe <fight.ippatu5648@gmail.com> (https://github.com/watanabeyu)",
  "bugs": {
    "url": "https://github.com/watanabeyu/react-native-store-version/issues"
  },
  "homepage": "https://github.com/watanabeyu/react-native-store-version",
  "peerDependencies": {
    "expo-application": "*",
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-device-info": "*"
  },
  "peerDependenciesMeta": {
    "expo-application": {
      "optional": true
    },
    "react-native-device-info": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@biomejs/biome": "2.6.5",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "babel-jest": "^30.0.0",
    "compare-versions": "6.1.1",
    "jest": "^30.0.0",
    "react": "^19.3.0",
    "react-native": "0.88.1",
    "test-renderer": "^1.0.0",
    "typescript": "^7.0.2"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "restoreMocks": true,
    "waitForUnhandledRejections": true,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.(ts|tsx)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/__helpers__/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90
      }
    }
  }
}
