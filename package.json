{
  "name": "react-native-store-version",
  "version": "1.4.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watanabeyu/react-native-store-version.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "appstore",
    "playstore",
    "version"
  ],
  "author": "Yu Watanabe <fight.ippatu5648@gmail.com> (https://github.com/watanabeyu)",
  "bugs": {
    "url": "https://github.com/watanabeyu/react-native-store-version/issues"
  },
  "homepage": "https://github.com/watanabeyu/react-native-store-version",
  "dependencies": {
    "compare-versions": "^4.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/jest": "^28.1.6",
    "@types/react-native": "^0.69.5",
    "babel-jest": "^28.1.3",
    "jest": "^28.1.3",
    "metro-react-native-babel-preset": "^0.72.0",
    "node-fetch": "^3.2.10",
    "react-native": "^0.69.3",
    "typescript": "^7.0.2"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.(ts|tsx|js)",
      "**/src/**/*.test.(ts|tsx|js)"
    ],
    "testPathIgnorePatterns": [
      "node_modules",
      "dist"
    ]
  }
}
